# Portal (SQLite)
# openssl rand -base64 32
SESSION_SECRET=
# Admin criado no primeiro start se não houver usuários
ADMIN_EMAIL=admin@portal.local
ADMIN_PASSWORD=
SQLITE_PATH=data/portal.db

# Tema/marca do cliente (ver src/styles/themes.css)
# Tema e nome entram no HTML estático no `next build`: mudar exige novo build.
CLIENT_THEME=default
CLIENT_NAME=Portal SAP

# Fuso do negócio para "hoje" (vencimentos, datas padrão). Não depende do fuso do servidor.
APP_TIME_ZONE=America/Sao_Paulo

# SAP B1 Service Layer (usuário técnico)
SAP_SL_URL=https://servidor:50000/b1s/v2
SAP_COMPANY_DB=SBODEMOBR
SAP_USER=manager
SAP_PASSWORD=
SAP_SL_INSECURE_TLS=false

# Contas contábeis padrão do recebimento (editáveis no form)
SAP_TRANSFER_ACCOUNT=
SAP_CASH_ACCOUNT=
